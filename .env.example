# ==============================================================================
# SadaOps Environment Configuration
# Copy this file to .env and fill in your local/free-tier API keys.
# NEVER commit .env to git.
# ==============================================================================

# --- LiveKit SFU (Local Docker Defaults) ---
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_HTTP_URL=http://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecret32

# --- Control-Plane API ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL (Local Docker Defaults) ---
POSTGRES_USER=sadaops
POSTGRES_PASSWORD=sadaops_dev_pass
POSTGRES_DB=sadaops
DATABASE_URL=postgresql://sadaops:sadaops_dev_pass@127.0.0.1:5432/sadaops
OPS_READONLY_DATABASE_URL=postgresql://ops_readonly:ops_readonly_pass@127.0.0.1:5432/sadaops

# --- Qdrant Vector DB (Local Docker Defaults) ---
QDRANT_URL=http://127.0.0.1:6333

# --- Jaeger / OpenTelemetry (Local Docker Defaults) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
JAEGER_UI_URL=http://127.0.0.1:16686

# --- Mailpit Local Email Sandbox (Local Docker Defaults) ---
MAILPIT_SMTP_HOST=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_API_URL=http://127.0.0.1:8025

# --- Google Workspace (Gmail + Google Calendar OAuth2) ---
# auto: uses Gmail/Google Calendar once connected via OAuth, else local Mailpit/Postgres
WORKSPACE_EMAIL_MODE=auto
WORKSPACE_CALENDAR_MODE=auto
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback
GOOGLE_REFRESH_TOKEN=
SADAOPS_GOOGLE_TOKEN_PATH=.sadaops_google_token.json
# Comma-separated trusted recipient domains when sending real emails (default: example.com,sadaops.example)
ALLOWED_EMAIL_DOMAINS=example.com,sadaops.example

# --- Speech & LLM Providers (Add your own free-tier keys in .env) ---
SPEECHMATICS_API_KEY=
GLADIA_API_KEY=
GROQ_API_KEY=
GROQ_API_KEY_2=
CARTESIA_API_KEY=

# Provider toggles:
# TTS_PROVIDER: "edge" (unlimited free dev/eval) or "cartesia" (ultra-low-latency live/demo)
TTS_PROVIDER=edge
# STT_PROVIDER: "gladia" (recommended solaria-1 AR/EN code-switching), "speechmatics", or "faster_whisper"
STT_PROVIDER=gladia
# LLM_MODEL / LLM_FALLBACK_MODEL: scoped fast 20B tool-calling + 120B Supervisor tier (Groq)
LLM_MODEL=openai/gpt-oss-20b
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Upgraded Turn Handling & Scoped Orchestration ---
ENABLE_TURN_DETECTOR=true
FALSE_INTERRUPTION_TIMEOUT_S=2.0
RESUME_FALSE_INTERRUPTION=true
ENABLE_SUPERVISOR_ROUTING=true

# --- Optional Phase 5 / Eval Additions ---
GITHUB_MODE=fixture
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_ALLOWED_REPOS=*
HF_TOKEN=
